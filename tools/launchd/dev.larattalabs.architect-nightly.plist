<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Architect nightly full gate run (docs/GATES.md "Affected-only releases"): tools/nightly.mjs at about 02:00 local.
     A template: tools/nightly-install.mjs fills the __PLACEHOLDERS__ and installs it as a user LaunchAgent. No notification,
     no credentials: the environment below is all it gets. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.larattalabs.architect-nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__REPO__/tools/nightly.mjs</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>2</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>JAVA_HOME</key>
		<string>__JAVA_HOME__</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/architect-nightly.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/architect-nightly.log</string>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<false/>
</dict>
</plist>
