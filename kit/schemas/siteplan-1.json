{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/larattalabs/architect-mc/kit/schemas/siteplan-1.json",
  "title": "siteplan/1",
  "description": "A region plan's geometry as data (docs/CONTRACT.md phase 6b §3.4; widened in 6c V without changing a member: edge type and path kind `path`, node kind `plaza`, mover `villager`, optional node `ports`, edge `width` and top-level `unplaced`, `derived` false for an IR graph; 7a K1: top-level `walls`, node kind `gate`, edge type `rope_bridge` with its `crossing`; 6c T3: top-level `bridges` and `tunnels`, edge types `bridge` and `tunnel` with their `crossing`). Members may be added within format 1; any change to an existing member is a format bump.",
  "type": "object",
  "required": ["format", "planId", "irSha", "claim", "stages", "lots", "paths", "utility", "anchors", "parts", "graph"],
  "properties": {
    "format": { "const": 1 },
    "planId": { "type": ["string", "null"] },
    "irSha": { "type": ["string", "null"] },
    "claim": { "type": "object", "required": ["minX", "minZ", "maxX", "maxZ"], "properties": { "minX": { "type": "integer" }, "minZ": { "type": "integer" }, "maxX": { "type": "integer" }, "maxZ": { "type": "integer" }, "minY": { "type": "integer" }, "maxY": { "type": "integer" } } },
    "stages": { "type": "array", "items": { "type": "string" } },
    "lots": { "type": "array", "items": { "type": "object", "required": ["id", "stage", "rect", "floorY", "front", "entrance"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "stage": { "type": "string" }, "rect": { "$ref": "#/$defs/rect" }, "floorY": { "type": "integer" },
      "front": { "enum": ["north", "south", "east", "west"] }, "entrance": { "$ref": "#/$defs/xyz" }, "brief": { "type": "string" },
      "lamps": { "type": "integer" }, "part": { "type": "string" } } } },
    "paths": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "stage", "width", "points"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "kind": { "enum": ["stair", "bridge", "graded", "road", "path"] }, "stage": { "type": "string" }, "width": { "type": "integer", "minimum": 1 },
      "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/xyz" } }, "part": { "type": "string" } } } },
    "utility": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "width", "height", "points"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "kind": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "points": { "type": "array", "items": { "$ref": "#/$defs/xyz" } } } } },
    "anchors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/xyz" } },
    "parts": { "type": "array", "items": { "type": "object", "required": ["id", "stage", "kind", "floating"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "stage": { "type": "string" }, "kind": { "enum": ["carve", "add", "path", "pad", "form"] }, "floating": { "type": "boolean" } } } },
    "graph": { "type": "object", "required": ["derived", "nodes", "edges"], "additionalProperties": false, "properties": {
      "derived": { "type": "boolean" },
      "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "ref", "at", "level"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "kind": { "enum": ["lot", "anchor", "junction", "plaza", "gate", "access"] }, "ref": { "type": ["string", "null"] }, "at": { "$ref": "#/$defs/xyz" }, "level": { "type": "integer" }, "part": { "type": "string" },
        "ports": { "type": "array", "items": { "type": "object", "required": ["name", "at", "facing", "width"], "additionalProperties": false, "properties": {
          "name": { "type": "string" }, "at": { "$ref": "#/$defs/xyz" }, "facing": { "enum": ["north", "south", "east", "west", "up"] }, "width": { "type": "integer", "minimum": 1 } } } } } } },
      "edges": { "type": "array", "items": { "type": "object", "required": ["id", "from", "to", "type", "path", "stage", "mover"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "type": { "enum": ["road", "stair", "bridge", "graded", "path", "rope_bridge", "tunnel", "switchback", "ladder", "lift", "catwalk", "rock_stair", "stairs_around", "wall_walk"] }, "width": { "type": "integer", "minimum": 1 },
        "path": { "type": "string" }, "stage": { "type": "string" }, "mover": { "type": "array", "items": { "enum": ["player", "villager"] } }, "part": { "type": "string" }, "external": { "type": "boolean", "description": "(6c D1) to is another region's port, <region>:<node>.<port> (a district's join to the standing region it was planned beside; 7a types it)" },
        "crossing": { "type": "object", "required": ["type"], "additionalProperties": false, "description": "(7a K1) a rope bridge's crossing {type: rope_bridge, over, depth}; (6c T3, S-T3-1, S-T3-8) a bridge's {type: bridge, form, over, depth, clearance, span, lands?} and a tunnel's {type: tunnel, through: rock, length, cover, lands?} (lands: the gate or postern it lands at); (7a) {type: stair|switchback, rise, flights|hairpins}, {type: ladder, rise, landings}, {type: lift, rise, down}, {type: catwalk, length, brackets}, {type: rock_stair, rise, steps, cover}, {type: stairs_around, host, rise, turns}", "properties": { "type": { "enum": ["rope_bridge", "bridge", "tunnel", "stair", "switchback", "ladder", "lift", "catwalk", "rock_stair", "stairs_around"] }, "over": { "enum": ["gap", "water"] }, "depth": { "type": "integer" }, "form": { "enum": ["beam", "arch"] }, "clearance": { "type": "integer" }, "span": { "type": "integer" }, "lands": { "type": "string" }, "through": { "enum": ["rock"] }, "length": { "type": "integer" }, "cover": { "type": "integer" }, "rise": { "type": "integer" }, "flights": { "type": "integer", "minimum": 0 }, "hairpins": { "type": "integer", "minimum": 0 }, "landings": { "type": "integer", "minimum": 0 }, "down": { "type": "boolean" }, "brackets": { "type": "integer", "minimum": 0 }, "steps": { "type": "integer", "minimum": 0 }, "host": { "type": "string" }, "turns": { "type": "number", "minimum": 0 } } } } } } } },
    "walls": { "type": "array", "description": "(7a K1) the plan's walls: each wall's line (its centre cells' corners, [x, z]), whether it is closed, and its gates", "items": { "type": "object", "required": ["id", "part", "line", "closed", "gates"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "line": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } } }, "closed": { "type": "boolean" },
      "gates": { "type": "array", "items": { "type": "object", "required": ["id", "at", "width", "door", "auto"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "at": { "$ref": "#/$defs/xyz" }, "width": { "type": "integer", "minimum": 1 }, "door": { "enum": ["none", "door", "fence_gate"] }, "auto": { "type": "boolean" } } } },
      "walk": { "type": "object", "description": "(7a K2) the wall walk, when the wall has one: {width, runs (between its accesses), accesses: [{kind: stair|ladder, at (the walk cell it lands on), foot}]}" }, "spine": { "type": "array", "description": "(7a K2) an along wall's spine (the boundary window it follows, [x, z] cells)", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } } }, "lots": { "type": "array", "description": "(7a K3) the lots on the wall's line" } } } },
    "bridges": { "type": "array", "description": "(6c T3) the plan's bridges: form, span (deck cells), the piers' centre columns and the two landings", "items": { "type": "object", "required": ["id", "part", "form", "span", "piers", "landings"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "form": { "enum": ["beam", "arch"] }, "span": { "type": "integer", "minimum": 1 },
      "piers": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } } }, "landings": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/xyz" } } } } },
    "tunnels": { "type": "array", "description": "(6c T3) the plan's tunnels: the portals (the first and last bore cells' floor), the length (floor cells) and the cells carved", "items": { "type": "object", "required": ["id", "part", "portals", "length", "carved"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "portals": { "type": "array", "items": { "$ref": "#/$defs/xyz" } }, "length": { "type": "integer", "minimum": 1 }, "carved": { "type": "integer", "minimum": 0 } } } },
    "climbs": { "type": "array", "description": "(7a CL) the plan's stairs, switchbacks and ladders: their flights, hairpins and ladders (each ladder's foot, rungs and rest landings)", "items": { "type": "object", "required": ["id", "part", "kind", "flights", "hairpins", "ladders"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "kind": { "enum": ["stair", "switchback", "ladder"] }, "flights": { "type": "integer", "minimum": 0 }, "hairpins": { "type": "integer", "minimum": 0 },
      "ladders": { "type": "array", "items": { "type": "object", "required": ["at", "rungs", "landings"], "additionalProperties": false, "properties": { "at": { "$ref": "#/$defs/xyz" }, "rungs": { "type": "integer", "minimum": 0 }, "landings": { "type": "integer", "minimum": 0 } } } } } } },
    "rockStairs": { "type": "array", "description": "(7a RK) the plan's rock stairs: steps, landings, cells carved and lined", "items": { "type": "object", "required": ["id", "part", "steps", "landings", "carved", "lined"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "steps": { "type": "integer", "minimum": 0 }, "landings": { "type": "integer", "minimum": 0 }, "carved": { "type": "integer", "minimum": 0 }, "lined": { "type": "integer", "minimum": 0 } } } },
    "lifts": { "type": "array", "description": "(7a LF) the plan's lifts: the foot and top cells, the rise, a down column", "items": { "type": "object", "required": ["id", "part", "foot", "top", "rise", "down"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "foot": { "$ref": "#/$defs/xyz" }, "top": { "$ref": "#/$defs/xyz" }, "rise": { "type": "integer", "minimum": 0 }, "down": { "type": "boolean" } } } },
    "catwalks": { "type": "array", "description": "(7a CW) the plan's catwalks: deck cells and brackets", "items": { "type": "object", "required": ["id", "part", "cells", "brackets"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "cells": { "type": "integer", "minimum": 0 }, "brackets": { "type": "integer", "minimum": 0 } } } },
    "spirals": { "type": "array", "description": "(7a SA) the plan's spiral stairs: the host form part, the rise, the turns, the top cell", "items": { "type": "object", "required": ["id", "part", "host", "rise", "turns", "top"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "host": { "type": "string" }, "rise": { "type": "integer", "minimum": 0 }, "turns": { "type": "number", "minimum": 0 }, "top": { "$ref": "#/$defs/xyz" } } } },
    "waters": { "type": "array", "description": "(6c H) the plan's fluid bodies: kind, fluid, surface level, the counts of source cells, declared spill cells and ice-capped cells", "items": { "type": "object", "required": ["id", "part", "kind", "fluid", "level", "cells", "spill", "ice"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "kind": { "enum": ["pond", "fountain", "waterfall", "moat", "farm_pond", "well", "course", "race", "ditch"] }, "fluid": { "enum": ["water", "lava"] }, "level": { "type": "integer" },
      "cells": { "type": "integer", "minimum": 1 }, "spill": { "type": "integer", "minimum": 0 }, "ice": { "type": "integer", "minimum": 0 } } } },
    "courses": { "type": "array", "description": "(6c HY) the plan's courses, races and ditches: one row per part, its reach bodies (ids <part>_r<k> from the head; their waters rows), the steps between them, its two ends, a race's serves and the water gates it passes", "items": { "type": "object", "required": ["id", "part", "kind", "look", "flow", "bodies", "steps", "ends"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "kind": { "enum": ["course", "race", "ditch"] }, "look": { "enum": ["natural", "built"] }, "flow": { "enum": ["level", "pools", "riffles"] },
      "bodies": { "type": "array", "items": { "type": "string" } },
      "steps": { "type": "array", "items": { "type": "object", "required": ["kind", "from", "to", "drop"], "additionalProperties": false, "properties": { "kind": { "enum": ["fall", "spillway", "riffle"] }, "from": { "type": "string" }, "to": { "type": "string" }, "drop": { "type": "integer", "minimum": 1 } } } },
      "ends": { "type": "array", "items": { "type": "object", "required": ["end", "kind", "ref"], "additionalProperties": false, "properties": { "end": { "enum": ["from", "to"] }, "kind": { "enum": ["spring", "pool", "weir", "join", "overflow", "rim"] }, "ref": { "type": "string" } } } },
      "serves": { "type": "object" }, "waterGates": { "type": "array" } } } },
    "quays": { "type": "array", "description": "(6c H) the plan's quays: the deck's first and last cells along the shore, its length and reach, and the cells written in natural water", "items": { "type": "object", "required": ["id", "part", "along", "length", "reach", "wetCells"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "along": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/xyz" } }, "length": { "type": "integer", "minimum": 1 },
      "reach": { "type": "integer", "minimum": 1 }, "wetCells": { "type": "integer", "minimum": 0 } } } },
    "unplaced": { "type": "array", "items": { "type": "object", "required": ["id", "reason"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "reason": { "type": "string" } } } },
    "props": { "type": "array", "items": { "type": "object", "required": ["kind", "id", "at"], "additionalProperties": false, "properties": {
      "kind": { "type": "string" }, "id": { "type": "string" }, "lot": { "type": "string" }, "at": { "$ref": "#/$defs/xyz" } } } },
    "passes": { "type": "array", "items": { "type": "object", "required": ["name", "ms", "heapMb"], "additionalProperties": false, "properties": {
      "name": { "type": "string" }, "ms": { "type": "integer", "minimum": 0 }, "heapMb": { "type": "integer", "minimum": 0 } } } },
    "planParts": { "type": "array", "description": "(6c P0) a plan check's part rects (plan/0 ids, with their class); lots, paths, nodes and edges then name their plan part in `part`", "items": { "type": "object", "required": ["part", "class", "rect"], "additionalProperties": false, "properties": {
      "part": { "type": "string" }, "class": { "type": "string" }, "rect": { "$ref": "#/$defs/rect" } } } }
  },
  "$defs": {
    "xyz": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } },
    "rect": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } }
  }
}
