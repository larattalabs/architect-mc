{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/larattalabs/architect-mc/kit/schemas/siteplan-1.json",
  "title": "siteplan/1",
  "description": "A region plan's geometry as data (docs/CONTRACT.md phase 6b §3.4; widened in 6c V without changing a member: edge type and path kind `path`, node kind `plaza`, mover `villager`, optional node `ports`, edge `width` and top-level `unplaced`, `derived` false for an IR graph; 7a K1: top-level `walls`, node kind `gate`, edge type `rope_bridge` with its `crossing`; 6c T3: top-level `bridges` and `tunnels`, edge types `bridge` and `tunnel` with their `crossing`). Members may be added within format 1; any change to an existing member is a format bump.",
  "type": "object",
  "required": ["format", "planId", "irSha", "claim", "stages", "lots", "paths", "utility", "anchors", "parts", "graph"],
  "properties": {
    "format": { "const": 1 },
    "planId": { "type": ["string", "null"] },
    "irSha": { "type": ["string", "null"] },
    "claim": { "type": "object", "required": ["minX", "minZ", "maxX", "maxZ"], "properties": { "minX": { "type": "integer" }, "minZ": { "type": "integer" }, "maxX": { "type": "integer" }, "maxZ": { "type": "integer" }, "minY": { "type": "integer" }, "maxY": { "type": "integer" } } },
    "stages": { "type": "array", "items": { "type": "string" } },
    "lots": { "type": "array", "items": { "type": "object", "required": ["id", "stage", "rect", "floorY", "front", "entrance"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "stage": { "type": "string" }, "rect": { "$ref": "#/$defs/rect" }, "floorY": { "type": "integer" },
      "front": { "enum": ["north", "south", "east", "west"] }, "entrance": { "$ref": "#/$defs/xyz" }, "brief": { "type": "string" },
      "lamps": { "type": "integer" }, "part": { "type": "string" } } } },
    "paths": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "stage", "width", "points"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "kind": { "enum": ["stair", "bridge", "graded", "road", "path"] }, "stage": { "type": "string" }, "width": { "type": "integer", "minimum": 1 },
      "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/xyz" } }, "part": { "type": "string" } } } },
    "utility": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "width", "height", "points"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "kind": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "points": { "type": "array", "items": { "$ref": "#/$defs/xyz" } } } } },
    "anchors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/xyz" } },
    "parts": { "type": "array", "items": { "type": "object", "required": ["id", "stage", "kind", "floating"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "stage": { "type": "string" }, "kind": { "enum": ["carve", "add", "path", "pad", "form"] }, "floating": { "type": "boolean" } } } },
    "graph": { "type": "object", "required": ["derived", "nodes", "edges"], "additionalProperties": false, "properties": {
      "derived": { "type": "boolean" },
      "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "ref", "at", "level"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "kind": { "enum": ["lot", "anchor", "junction", "plaza", "gate"] }, "ref": { "type": ["string", "null"] }, "at": { "$ref": "#/$defs/xyz" }, "level": { "type": "integer" }, "part": { "type": "string" },
        "ports": { "type": "array", "items": { "type": "object", "required": ["name", "at", "facing", "width"], "additionalProperties": false, "properties": {
          "name": { "type": "string" }, "at": { "$ref": "#/$defs/xyz" }, "facing": { "enum": ["north", "south", "east", "west", "up"] }, "width": { "type": "integer", "minimum": 1 } } } } } } },
      "edges": { "type": "array", "items": { "type": "object", "required": ["id", "from", "to", "type", "path", "stage", "mover"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "type": { "enum": ["road", "stair", "bridge", "graded", "path", "rope_bridge", "tunnel"] }, "width": { "type": "integer", "minimum": 1 },
        "path": { "type": "string" }, "stage": { "type": "string" }, "mover": { "type": "array", "items": { "enum": ["player", "villager"] } }, "part": { "type": "string" }, "external": { "type": "boolean", "description": "(6c D1) to is another region's port, <region>:<node>.<port> (a district's join to the standing region it was planned beside; 7a types it)" },
        "crossing": { "type": "object", "required": ["type"], "additionalProperties": false, "description": "(7a K1) a rope bridge's crossing {type: rope_bridge, over, depth}; (6c T3, S-T3-1, S-T3-8) a bridge's {type: bridge, form, over, depth, clearance, span, lands?} and a tunnel's {type: tunnel, through: rock, length, cover, lands?} (lands: the gate or postern it lands at)", "properties": { "type": { "enum": ["rope_bridge", "bridge", "tunnel"] }, "over": { "enum": ["gap", "water"] }, "depth": { "type": "integer" }, "form": { "enum": ["beam", "arch"] }, "clearance": { "type": "integer" }, "span": { "type": "integer" }, "lands": { "type": "string" }, "through": { "enum": ["rock"] }, "length": { "type": "integer" }, "cover": { "type": "integer" } } } } } } } },
    "walls": { "type": "array", "description": "(7a K1) the plan's walls: each wall's line (its centre cells' corners, [x, z]), whether it is closed, and its gates", "items": { "type": "object", "required": ["id", "part", "line", "closed", "gates"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "line": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } } }, "closed": { "type": "boolean" },
      "gates": { "type": "array", "items": { "type": "object", "required": ["id", "at", "width", "door", "auto"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "at": { "$ref": "#/$defs/xyz" }, "width": { "type": "integer", "minimum": 1 }, "door": { "enum": ["none", "door", "fence_gate"] }, "auto": { "type": "boolean" } } } } } } },
    "bridges": { "type": "array", "description": "(6c T3) the plan's bridges: form, span (deck cells), the piers' centre columns and the two landings", "items": { "type": "object", "required": ["id", "part", "form", "span", "piers", "landings"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "form": { "enum": ["beam", "arch"] }, "span": { "type": "integer", "minimum": 1 },
      "piers": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } } }, "landings": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/xyz" } } } } },
    "tunnels": { "type": "array", "description": "(6c T3) the plan's tunnels: the portals (the first and last bore cells' floor), the length (floor cells) and the cells carved", "items": { "type": "object", "required": ["id", "part", "portals", "length", "carved"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "part": { "type": "string" }, "portals": { "type": "array", "items": { "$ref": "#/$defs/xyz" } }, "length": { "type": "integer", "minimum": 1 }, "carved": { "type": "integer", "minimum": 0 } } } },
    "unplaced": { "type": "array", "items": { "type": "object", "required": ["id", "reason"], "additionalProperties": false, "properties": {
      "id": { "type": "string" }, "reason": { "type": "string" } } } },
    "props": { "type": "array", "items": { "type": "object", "required": ["kind", "id", "at"], "additionalProperties": false, "properties": {
      "kind": { "type": "string" }, "id": { "type": "string" }, "lot": { "type": "string" }, "at": { "$ref": "#/$defs/xyz" } } } },
    "passes": { "type": "array", "items": { "type": "object", "required": ["name", "ms", "heapMb"], "additionalProperties": false, "properties": {
      "name": { "type": "string" }, "ms": { "type": "integer", "minimum": 0 }, "heapMb": { "type": "integer", "minimum": 0 } } } },
    "planParts": { "type": "array", "description": "(6c P0) a plan check's part rects (plan/0 ids, with their class); lots, paths, nodes and edges then name their plan part in `part`", "items": { "type": "object", "required": ["part", "class", "rect"], "additionalProperties": false, "properties": {
      "part": { "type": "string" }, "class": { "type": "string" }, "rect": { "$ref": "#/$defs/rect" } } } }
  },
  "$defs": {
    "xyz": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } },
    "rect": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } }
  }
}
